{{!
    @template aiprovider_ragflow/drawer

    The shared RAGflow chat drawer plus its floating toggle button.

    Context variables required for this template:
    * userid int The current user id
    * contextid int The page context id
    * component string The calling placement component (for the capability check)
    * label string The button/title label (e.g. RAGflow Tutor / RAGflow Helpdesk)
    * greeting string Optional first assistant message

    Example context (json):
    {
        "userid": 2,
        "contextid": 34,
        "component": "aiplacement_ragflowchat",
        "label": "RAGflow Tutor",
        "greeting": "Hi!"
    }
}}
{{^page}}
<button type="button" class="btn btn-primary rfchat-fab" data-action="ragflowchat-toggle">
    {{label}}
</button>
{{/page}}
<div id="ragflowchat-drawer" class="rfchat-drawer{{#page}} rfchat-page{{/page}}" role="region"
     aria-label="{{label}}" {{^page}}hidden{{/page}}>
    <div class="rfchat-header">
        <span class="rfchat-title">{{label}}</span>
        {{#memory}}
        <span class="rfchat-newconv">
            <button type="button" class="btn btn-sm btn-link rfchat-reset" data-action="ragflowchat-reset">
                {{#str}} chatnewconversation, aiprovider_ragflow {{/str}}
            </button>
            {{{newconvhelp}}}
        </span>
        {{/memory}}
        {{#longterm}}
        <span class="rfchat-newconv">
            <button type="button" class="btn btn-sm btn-link rfchat-reset-private"
                    data-action="ragflowchat-reset-private">
                {{#str}} chatnewprivate, aiprovider_ragflow {{/str}}
            </button>
            {{{newprivatehelp}}}
        </span>
        {{/longterm}}
        {{^page}}
        <button type="button" class="btn btn-icon rfchat-close-btn" data-action="ragflowchat-close"
                aria-label="{{#str}} closebuttontitle, core {{/str}}">&times;</button>
        {{/page}}
    </div>
    <div class="rfchat-messages" data-region="ragflowchat-messages" aria-live="polite">
        {{#greeting}}
        <div class="rfchat-msg rfchat-assistant">
            <div class="rfchat-bubble">{{greeting}}</div>
        </div>
        {{/greeting}}
    </div>
    <form data-region="ragflowchat-form" class="rfchat-form">
        <textarea data-region="ragflowchat-input" class="form-control" rows="2"
                  placeholder="{{#str}} chatplaceholder, aiprovider_ragflow {{/str}}"></textarea>
        <button type="submit" class="btn btn-primary">{{#str}} chatsend, aiprovider_ragflow {{/str}}</button>
    </form>
    <div class="rfchat-sources" data-region="ragflowchat-sources" hidden>
        <div class="rfchat-sources-title">{{#str}} sourcesheading, aiprovider_ragflow {{/str}}</div>
        <div class="rfchat-sources-list" data-region="ragflowchat-sources-list"></div>
    </div>
    {{#longterm}}
    <div class="rfchat-forgetbar">
        <button type="button" class="btn btn-sm btn-link rfchat-forget" data-action="ragflowchat-forget">
            {{#str}} chatforgetmemory, aiprovider_ragflow {{/str}}
        </button>
        {{{forgethelp}}}
    </div>
    {{/longterm}}
</div>
