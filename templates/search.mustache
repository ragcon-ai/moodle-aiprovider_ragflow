{{!
    @template aiprovider_ragflow/search

    RAGflow semantic-search widget (used by the search block).

    Context variables required for this template:
    * uid string A unique root element id
    * contextid int The page context id
    * blockinstanceid int The search block instance id (drives the knowledge base + scope)

    Example context (json):
    {
        "uid": "rfsearch_abc",
        "contextid": 34,
        "blockinstanceid": 12
    }
}}
<div id="{{uid}}" class="rfsearch">
    <form data-region="form" class="rfsearch-form">
        <input type="text" data-region="input" class="form-control"
               placeholder="{{#str}} searchplaceholder, aiprovider_ragflow {{/str}}">
        <button type="submit" class="btn btn-primary">{{#str}} searchbutton, aiprovider_ragflow {{/str}}</button>
    </form>
    <div data-region="results" class="rfsearch-results" aria-live="polite"></div>
</div>
{{#js}}
require(['aiprovider_ragflow/search'], function(Search) {
    Search.init('{{uid}}', {{contextid}}, {{blockinstanceid}});
});
{{/js}}
